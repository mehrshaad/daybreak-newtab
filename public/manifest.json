{
  "manifest_version": 3,
  "name": "Daybreak - New Tab",
  "version": "2.0.0",
  "description": "Start every tab fresh: a customizable widget dashboard with a clock, weather, tasks, quick links, and more.",
  "author": "Ali Dadashzadeh",
  "permissions": ["storage"],
  "optional_permissions": ["sessions"],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "homepage_url": "https://github.com/mehrshaad/daybreak-newtab",
  "offline_enabled": true,
  "incognito": "split"
}
